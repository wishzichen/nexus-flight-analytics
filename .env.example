# Sub2API OpenAI-compatible backend proxy settings.
# Keep the real key only in local or server environment variables.
SUB2API_BASE_URL="https://sub2api.cian.fun/v1"
SUB2API_API_KEY="YOUR_SUB2API_API_KEY"
SUB2API_MODEL="gpt-5.5"
SUB2API_FALLBACK_MODELS="gpt-5.4-mini,gpt-5.2-chat-latest,gpt-5.1,claude-haiku-4-5,grok-4.20-fast"
SUB2API_TIMEOUT_MS="45000"

# Optional deployment URL for generated links and diagnostics.
APP_URL="http://localhost:3000"
